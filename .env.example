# PostMortemAI — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: gemini (default, free) | openrouter (free tier) | ollama (local)
LLM_PROVIDER=gemini

# Gemini — Google AI Studio, free, no CC required: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
# GEMINI_MODEL=gemini-2.0-flash   # default

# OpenRouter — only needed when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-YOUR_KEY_HERE

# Anthropic — only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── Competitor Lookup (Serper.dev) ────────────────────────────────────────────
# Free tier = 2500 searches, no CC required: https://serper.dev
SERPER_API_KEY=YOUR_SERPER_KEY_HERE

# ── Scraping ──────────────────────────────────────────────────────────────────
# Firecrawl — primary scraper, free tier = 500 credits: https://firecrawl.dev
# Jina.ai reader is used as automatic fallback (no key needed)
FIRECRAWL_API_KEY=fc-YOUR_KEY_HERE

# ── Qdrant — vector database ──────────────────────────────────────────────────
# Local: docker run -p 6333:6333 qdrant/qdrant
# Cloud: https://cloud.qdrant.io (free tier available)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # Leave empty for local, required for Qdrant Cloud
QDRANT_COLLECTION=postmortems

# ── API ───────────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000
