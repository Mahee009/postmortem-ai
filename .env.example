# PostMortemAI — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openrouter (default, prod) | ollama (local dev)
# Model is auto-discovered at runtime — no model name needed
LLM_PROVIDER=openrouter

# OpenRouter — free tier, no CC required: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-YOUR_KEY_HERE

# Ollama — local dev only, set LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:14b   # default

# ── Competitor Lookup (Serper.dev) ────────────────────────────────────────────
# Free tier = 2500 searches, no CC required: https://serper.dev
SERPER_API_KEY=YOUR_SERPER_KEY_HERE

# ── Scraping ──────────────────────────────────────────────────────────────────
# Firecrawl — primary scraper, free tier = 500 credits: https://firecrawl.dev
# Jina.ai reader is used as automatic fallback (no key needed)
FIRECRAWL_API_KEY=fc-YOUR_KEY_HERE

# ── Qdrant — vector database ──────────────────────────────────────────────────
# Local: docker run -p 6333:6333 qdrant/qdrant
# Cloud: https://cloud.qdrant.io (free tier available)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # Leave empty for local, required for Qdrant Cloud
QDRANT_COLLECTION=postmortems

# ── API ───────────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000
